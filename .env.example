OLLAMA_URL=http://localhost:11434
# Default model used by all roles unless a role-specific model is set.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional role-specific models. Different models can be used for specialization.
OLLAMA_MODEL_RESEARCHER=
OLLAMA_MODEL_ARCHITECT=
OLLAMA_MODEL_SECURITY=
OLLAMA_MODEL_ECONOMIC=
OLLAMA_MODEL_IMPLEMENTER=
OLLAMA_MODEL_REVIEWER=
OLLAMA_MODEL_TESTER=
OLLAMA_MODEL_REMEDIATION=
OLLAMA_MODEL_AUDITOR=

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=defi_research
MAX_TOOL_ROUNDS=30
MULTI_AGENT_MAX_ROUNDS=18
RESEARCH_TOP_K=8
